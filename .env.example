# Подключение к серверу Minecraft
MC_HOST=host.docker.internal
MC_PORT=25565 # Стандартный порт для PaperMC
BOT_USERNAME=AI_Agent

# Адрес когнитивного сервера (Python) для Node.js
BRAIN_URL=http://brain:8000/decide

# Адрес локальной LLM (Ollama) для Python
OLLAMA_URL=http://host.docker.internal:11434/api/generate

# Название локальной LLM (по умолчанию - "llama3.1:8b"):
LLM_MODEL="llama3.1:8b"

# Название модели для векторизации (по умолчанию - "intfloat/multilingual-e5-small"):
EMBEDDING_MODEL="intfloat/multilingual-e5-small"